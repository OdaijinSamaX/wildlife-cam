[Unit]
Description=Wildlife Camera Child Node
After=network.target bluetooth.target
Wants=network.target bluetooth.target

[Service]
Type=simple
User=odaijinsamax
WorkingDirectory=/home/odaijinsamax/wildlife-cam
Environment=WILDLIFE_CAM_HOME=/home/odaijinsamax/wildlife-cam
Environment=WILDLIFE_CAM_ENV_FILE=/home/odaijinsamax/wildlife-cam/config/.env
ExecStart=/usr/bin/python3 /home/odaijinsamax/wildlife-cam/child_main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
