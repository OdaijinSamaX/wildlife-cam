GOOGLE_SCRIPT_URL=
LOG_LEVEL=INFO
VIDEO_RETENTION_ON_FAIL=true

# --- 送信量・撮影の現地設定（既定値はコード側にある。ここは上書き用。#を外して有効化） ---
# LTE 経由の送信量上限（1時間・MB）。超えたら「送信のみ」止め、録画は SD に貯める。WiFi は無制限。
#WILDLIFE_UPLOAD_BUDGET_MB_PER_HOUR=250
# 送信待ちがこの本数を超えたら「新しい順」で送る（実演で最新の1本を先に届けるため）。
#WILDLIFE_UPLOAD_NEWEST_FIRST_BACKLOG=10
# 撮影クールダウン秒（既定 0=無効。撮り逃し防止のため通常は 0 のまま）。
#WILDLIFE_MOTION_COOLDOWN_SEC=0
# 誤検知サーキットブレーカー（既定 OFF。将来のバッテリー保護用の予備。撮り続けたい方針とは矛盾）。
#WILDLIFE_BURST_PAUSE_ENABLED=0
#WILDLIFE_BURST_THRESHOLD=6
#WILDLIFE_BURST_WINDOW_SEC=1800
#WILDLIFE_BURST_PAUSE_SEC=3600
# 永続状態の置き場所（既定 /var/lib/wildlife-cam、書けなければ ~/wildlife-cam/state に退避）。
#WILDLIFE_STATE_DIR=/var/lib/wildlife-cam
# SD 保存の保護（既定: バイト/本数の上限は無効=0、空き最低 2GiB、保存 14 日）。
#WILDLIFE_MIN_FREE_BYTES=2147483648
#WILDLIFE_VIDEO_MAX_AGE_DAYS=14
#WILDLIFE_VIDEO_MAX_BYTES=0
#WILDLIFE_VIDEO_MAX_FILES=0